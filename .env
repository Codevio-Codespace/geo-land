# ============================================================================
# Geo&Land — environment configuration
# Fill in the two values below from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#     · Project URL          → SUPABASE_URL
#     · Project API "anon public" key → SUPABASE_ANON_KEY
# The anon key is safe in the browser — access is controlled by the Row Level
# Security policies installed by supabase/schema.sql.
# ============================================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Port for the local server (npm start / node server.js)
PORT=8080
